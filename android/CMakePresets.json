{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg-install",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": {
                    "type": "FILEPATH",
                    "value": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake"
                },
                "VCPKG_TARGET_TRIPLET": "unknown"
            },
            "environment": {
                "VCPKG_FEATURE_FLAGS": "versions,manifests,registries"
            }
        },
        {
            "name": "android-build",
            "generator": "Ninja",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "ANDROID_PLATFORM_LEVEL": "24",
                "ANDROID_PLATFORM": "24",
                "ANDROID_STL": "c++_shared",
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "arm64-android",
            "inherits": [
                "vcpkg-install",
                "android-build"
            ],
            "binaryDir": "${sourceDir}/build-arm64-android",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android"
            }
        },
        {
            "name": "x64-android",
            "inherits": "arm64-android",
            "binaryDir": "${sourceDir}/build-x64-android",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm64-android-debug",
            "configuration": "Debug",
            "configurePreset": "arm64-android"
        },
        {
            "name": "x64-android-debug",
            "configuration": "Debug",
            "configurePreset": "x64-android"
        }
    ]
}